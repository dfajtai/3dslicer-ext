{
  "_comment": "Reproduces DeerSegmentor.py + batch_exporter.py using the generic engine.",

  "study_dir": "/data/deer/nas_deer",
  "database_csv_path": "etc/deer_database.csv",
  "preseg_csv_path": "etc/preseg_paths.csv",

  "key_columns": ["sid"],
  "done_column": "done",
  "table_columns": ["sid", "group", "done"],
  "output_dir_pattern": ["sid", "slicer_seg"],

  "images": [
    {
      "name": "t1",
      "csv_column": "t1",
      "type": "volume",
      "role": "background",
      "required": true
    },
    {
      "name": "t2",
      "csv_column": "t2",
      "type": "volume",
      "role": null,
      "required": true
    },
    {
      "name": "rel",
      "csv_column": "rel",
      "type": "volume",
      "role": "foreground",
      "required": true,
      "preset": "rel_overlay"
    }
  ],

  "presets": {
    "rel_overlay": {
      "color_table": "vtkMRMLColorTableNodeRed",
      "threshold": { "min": 1, "max": 300, "apply": true },
      "window_level": { "min": 1, "max": 2 },
      "opacity": 0.45
    }
  },

  "segmentation": {
    "enabled": true,
    "mode": "per_label_images",
    "reference_image": "t1",
    "segments": [
      { "name": "t1_mask", "csv_column": "t1_mask", "color": [0, 0.2, 0.8] },
      { "name": "t2_mask", "csv_column": "t2_mask", "color": [0.8, 0.1, 0.8] },
      { "name": "mask",      "source": "empty", "color": [1, 1, 1] },
      { "name": "non-liver", "source": "empty", "color": [0, 0.8, 0.3] },
      { "name": "worm",      "source": "empty", "color": [1, 1, 0] }
    ],
    "output_filename": "segment.seg.nrrd",
    "opacity": 0.8
  },

  "landmarks": { "enabled": false },
  "volume_rendering": { "enabled": false },
  "window_level": { "enabled": false },

  "batch_export": {
    "enabled": true,
    "export_segments": true,
    "export_markups": false,
    "reference_image": "t1",
    "segments_filter": ["mask", "non-liver", "worm"]
  }
}
